# Copy to docker/.env for local Phase 4 full-stack compose runs (never
# commit the real file — root .gitignore's `**/.env` pattern already
# matches `docker/.env`). Consumed via `docker compose --env-file docker/.env
# -f docker/docker-compose.infra.yml -f docker/docker-compose.yml ...` (see
# docker/docker-compose.yml's own header comment for why `--env-file`
# specifically, and why per-service DATABASE_URL vars rather than one
# shared value). REDIS_URL/KAFKA_BROKERS/RABBITMQ_URL are NOT listed here —
# docker-compose.yml hardcodes those to the infra services' compose network
# addresses (redis:6379, kafka:9092, rabbitmq:5672) directly, since they're
# not secrets and don't vary by environment the way a database credential
# does.

# --- Database (Supavisor pooler, transaction mode, port 6543) --------------
# One distinct value per service — schema-per-service means each service
# authenticates as its own scoped Postgres role (see
# migrations/000_bootstrap.sql and docs/DECISIONS.md). Format:
#   postgres://<role>.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
#
# For local verification against a throwaway Postgres instead of real
# Supabase (see docs/DECISIONS.md's Phase 4 notes for the full recipe):
#   docker run --rm -d --name sbp-local-postgres -p 5432:5432 \
#     -e POSTGRES_PASSWORD=postgres postgres:16-alpine
#   psql "postgres://postgres:postgres@localhost:5432/postgres" -f ../migrations/000_bootstrap.sql
#   # then ALTER ROLE each service role's password to something known, and:
#   AUTH_DATABASE_URL=postgres://auth_service:devpassword@host.docker.internal:5432/postgres
# `host.docker.internal` is what lets a container reach a `docker run`
# container's published port on the host — it is NOT the same network as
# this compose project's containers, which is exactly why the throwaway
# Postgres stays outside these compose files (see docker-compose.yml's
# header comment) rather than joining the project network directly.
AUTH_DATABASE_URL=postgres://auth_service.CHANGE_ME_PROJECT_REF:CHANGE_ME_PASSWORD@CHANGE_ME_REGION.pooler.supabase.com:6543/postgres
SKILLS_DATABASE_URL=postgres://skills_service.CHANGE_ME_PROJECT_REF:CHANGE_ME_PASSWORD@CHANGE_ME_REGION.pooler.supabase.com:6543/postgres
USERS_DATABASE_URL=postgres://users_service.CHANGE_ME_PROJECT_REF:CHANGE_ME_PASSWORD@CHANGE_ME_REGION.pooler.supabase.com:6543/postgres
JOBS_DATABASE_URL=postgres://jobs_service.CHANGE_ME_PROJECT_REF:CHANGE_ME_PASSWORD@CHANGE_ME_REGION.pooler.supabase.com:6543/postgres
NOTIFICATION_DATABASE_URL=postgres://notification_service.CHANGE_ME_PROJECT_REF:CHANGE_ME_PASSWORD@CHANGE_ME_REGION.pooler.supabase.com:6543/postgres

# --- auth-service: JWT signing key (optional) -------------------------------
# Left unset here on purpose, same as backend/.env.example: auth-service
# generates a fresh ephemeral RS256 keypair at startup when unset, which is
# fine for a single-container local run but NOT fine across a restart or
# multiple replicas (every restart invalidates outstanding tokens). Set
# explicitly for anything longer-lived than a one-off local verification.
# JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_KID=

# --- auth-service: Google OAuth (optional) ----------------------------------
# Same as backend/.env.example — left unset since no live Google Cloud
# OAuth client exists in this environment. auth-service starts fine either
# way; GetGoogleAuthURL/GoogleOAuthCallback return FailedPrecondition until
# all three are set.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=

# --- api-gateway: rate limiting (optional) ----------------------------------
# Same as backend/.env.example — unset means ratelimit.DefaultConfig
# (100 requests / 60s window).
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60
