# Copy to backend/notification-service/.env for local dev (never commit
# the real file — see root .gitignore, which matches **/.env). Loaded via
# `dotenv` only when ENV != production, same gating as godotenv on the Go
# side (see backend/.env.example).

# development | production. Gates dotenv loading and pino-pretty local
# log formatting (see src/app.module.ts).
ENV=development

# HTTP port — /healthz and /readyz only, this service has no other HTTP
# surface (its real job is consuming RabbitMQ, see src/rabbitmq/). Kept
# in the 808x range alongside every other service's HTTP port
# (auth-service 8081, skills-service 8082, users-service 8083,
# jobs-service 8084, api-gateway 8080).
HTTP_PORT=8085

# pino log level.
LOG_LEVEL=info

# RabbitMQ connection string — same value and same degrade-gracefully
# pattern as backend/.env.example's RABBITMQ_URL (auth-service's
# producer side): unset or unreachable just means the notifications.email
# consumer never starts, logged once, not a startup failure. `make up`
# (from backend/) starts RabbitMQ locally via
# docker/docker-compose.infra.yml on this exact address (management UI at
# http://localhost:15672, guest/guest).
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Supabase Supavisor pooler connection string, TRANSACTION MODE (port
# 6543), for the notification_service role — same format/reasoning as
# every Go service's DATABASE_URL (see backend/.env.example and
# docs/DECISIONS.md). Left unset here on purpose; this service starts and
# serves health checks without it, it just can't write notification_log
# rows until it's configured (recordWelcomeEmail still logs the "would
# send" line either way — see src/notifications/notifications.service.ts).
DATABASE_URL=postgres://notification_service.CHANGE_ME_PROJECT_REF:CHANGE_ME_PASSWORD@CHANGE_ME_REGION.pooler.supabase.com:6543/postgres

# Sentry (error tracking — see src/main.ts and docs/DECISIONS.md's Sentry
# section). Same degrade-gracefully pattern as everything else here:
# unset means this service starts and runs exactly as before, just with
# no error reporting. Only local/kind value today — this service isn't
# part of the render.yaml production deploy (see
# backend/cmd/allinone/main.go's package doc comment). Left unset in this
# example on purpose; there is no live Sentry project yet (see
# docs/DEPLOYMENT.md).
# SENTRY_DSN=https://CHANGE_ME_PUBLIC_KEY@CHANGE_ME.ingest.sentry.io/CHANGE_ME_PROJECT_ID
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
