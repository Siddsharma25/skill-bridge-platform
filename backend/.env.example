# Copy to backend/.env for local dev (never commit the real file — see
# root .gitignore, which matches **/.env). Loaded via godotenv only when
# ENV != production; in production, set these as real environment
# variables / secrets instead (see docs/DECISIONS.md's Secrets Management
# section).

# --- Shared -----------------------------------------------------------------

# development | production. Gates godotenv.Load() and a few dev-only
# conveniences (GraphQL Playground, ephemeral JWT keypair generation).
ENV=development

# Redis connection string, shared by skills-service/jobs-service (caching,
# see internal/platform/cache), api-gateway (rate limiting, plus — as of
# Phase 3.5 — the realtime-notification pub/sub bridge and
# `onNotification` GraphQL subscription; see internal/gateway/realtime).
# Same degrade-gracefully pattern as DATABASE_URL: unset or unreachable
# just means "no caching / no rate limiting / no live notification
# delivery," logged once, not a startup failure — see docs/DECISIONS.md.
# `make up` (from backend/) starts Redis locally via
# docker/docker-compose.infra.yml on this exact address.
REDIS_URL=redis://localhost:6379/0

# Kafka broker list (comma-separated), used by users-service/skills-service
# (event publishing, see internal/platform/kafka) and jobs-service
# (publishing + its three Phase 2 consumers: snapshot projection, matching
# worker, cross-service cache invalidation). Same degrade-gracefully
# pattern as REDIS_URL: unset or unreachable just disables Kafka publishing
# / that consumer for this instance, logged once, not a startup failure —
# see docs/DECISIONS.md's Phase 2 notes. `make up` starts a single-broker
# KRaft-mode Kafka locally via docker/docker-compose.infra.yml on this
# exact address.
KAFKA_BROKERS=localhost:9092

# RabbitMQ connection string, used by auth-service (publishing the
# best-effort `notifications.email` welcome event on Register, plus a
# realtime `notifications.realtime` event — see internal/platform/rabbitmq),
# jobs-service (publishing a realtime `notifications.realtime` event per
# matched user from its Phase 2 matching worker — see
# internal/jobs/matcher.go), notification-service (consuming
# notifications.email — see backend/notification-service/.env.example),
# and api-gateway (consuming notifications.realtime and republishing onto
# Redis pub/sub — see internal/gateway/realtime, Phase 3.5). Same
# degrade-gracefully pattern as KAFKA_BROKERS: unset or unreachable just
# disables the publish/consumer for this instance, logged once, not a
# startup failure or a failed Register/CreateJob — see docs/DECISIONS.md's
# Phase 3 and Phase 3.5 notes. `make up` starts RabbitMQ locally via
# docker/docker-compose.infra.yml on this exact address (management UI at
# http://localhost:15672, guest/guest).
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- auth-service -------------------------------------------------------------

# gRPC port.
PORT=9001
# HTTP port (health checks + JWKS).
HTTP_PORT=8081

# Supabase Supavisor pooler connection string, TRANSACTION MODE (port
# 6543) — see internal/platform/db and docs/DECISIONS.md for why
# transaction mode specifically, and why PreferSimpleProtocol is required
# on the Go side because of it. Format:
#   postgres://<role>.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Left unset in this example on purpose — there is no live Supabase project
# yet. auth-service starts and serves health checks without this set; it
# just can't Register/Login until it's configured.
DATABASE_URL=postgres://auth_service.CHANGE_ME_PROJECT_REF:CHANGE_ME_PASSWORD@CHANGE_ME_REGION.pooler.supabase.com:6543/postgres

# JWT `iss` claim. Distinct per service issuing tokens (only auth-service
# does, today).
JWT_ISSUER=skill-bridge-platform/auth-service

# Optional: PEM-encoded RSA private key (PKCS1 or PKCS8). If unset, a
# fresh RS256 keypair is generated at process startup — fine for local
# dev, NOT fine for anything that restarts or runs more than one replica
# (see backend/cmd/auth-service/README.md).
# JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Optional: override the derived kid when JWT_PRIVATE_KEY_PEM is set.
# JWT_KID=

# Google OAuth (Phase 1c). All three left unset in this example on
# purpose — there is no live Google Cloud OAuth client yet (a real
# external dependency this repo can't create for you; see
# docs/DECISIONS.md). auth-service starts fine without these set; it just
# logs a warning and GetGoogleAuthURL/GoogleOAuthCallback both return a
# FailedPrecondition gRPC status until all three are set. Create a client
# in the Google Cloud Console (OAuth consent screen + Web application
# credentials) and set REDIRECT_URL to wherever the frontend's OAuth
# callback route lives (must match a URI registered on the client exactly).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5173/auth/google/callback

# --- skills-service -------------------------------------------------------------

# gRPC port.
# PORT=9002
# HTTP port (health checks).
# HTTP_PORT=8082

# Supavisor pooler connection string for the skills_service role — same
# format/reasoning as auth-service's DATABASE_URL above. Left unset here;
# skills-service starts and serves health checks without it, it just can't
# CreateSkill/ListSkills until it's configured.
# DATABASE_URL=postgres://skills_service.CHANGE_ME_PROJECT_REF:CHANGE_ME_PASSWORD@CHANGE_ME_REGION.pooler.supabase.com:6543/postgres

# --- users-service --------------------------------------------------------------

# gRPC port.
# PORT=9003
# HTTP port (health checks).
# HTTP_PORT=8083

# Supavisor pooler connection string for the users_service role.
# DATABASE_URL=postgres://users_service.CHANGE_ME_PROJECT_REF:CHANGE_ME_PASSWORD@CHANGE_ME_REGION.pooler.supabase.com:6543/postgres

# --- jobs-service ---------------------------------------------------------------

# gRPC port.
# PORT=9004
# HTTP port (health checks).
# HTTP_PORT=8084

# Supavisor pooler connection string for the jobs_service role.
# DATABASE_URL=postgres://jobs_service.CHANGE_ME_PROJECT_REF:CHANGE_ME_PASSWORD@CHANGE_ME_REGION.pooler.supabase.com:6543/postgres

# --- api-gateway --------------------------------------------------------------

# HTTP port (GraphQL + Playground + health).
# PORT=8080

# Where to reach auth-service's gRPC server.
AUTH_SERVICE_ADDR=localhost:9001

# Where to reach auth-service's JWKS document. api-gateway fetches and
# caches this at startup, then re-verifies every incoming bearer token
# against it in internal/gateway/authctx.Middleware — the first phase this
# plumbing is used for request-time verification, not just proven to
# work (see docs/DECISIONS.md).
AUTH_SERVICE_JWKS_URL=http://localhost:8081/.well-known/jwks.json

# Where to reach skills-service's / users-service's / jobs-service's gRPC
# servers.
SKILLS_SERVICE_ADDR=localhost:9002
USERS_SERVICE_ADDR=localhost:9003
JOBS_SERVICE_ADDR=localhost:9004

# Rate limiting (Phase 1c, Redis-backed — see REDIS_URL above and
# internal/gateway/ratelimit). Fixed window: at most this many requests
# per key (verified user ID once authenticated, else client IP) within
# this many seconds. Both optional — unset means ratelimit.DefaultConfig
# (100 requests / 60s). See docs/DECISIONS.md for why these particular
# numbers.
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60
