# Copy to backend/.env for local dev (never commit the real file — see
# root .gitignore, which matches **/.env). Loaded via godotenv only when
# ENV != production; in production, set these as real environment
# variables / secrets instead (see docs/DECISIONS.md's Secrets Management
# section).

# --- Shared -----------------------------------------------------------------

# development | production. Gates godotenv.Load() and a few dev-only
# conveniences (GraphQL Playground, ephemeral JWT keypair generation).
ENV=development

# --- auth-service -------------------------------------------------------------

# gRPC port.
PORT=9001
# HTTP port (health checks + JWKS).
HTTP_PORT=8081

# Supabase Supavisor pooler connection string, TRANSACTION MODE (port
# 6543) — see internal/platform/db and docs/DECISIONS.md for why
# transaction mode specifically, and why PreferSimpleProtocol is required
# on the Go side because of it. Format:
#   postgres://<role>.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Left unset in this example on purpose — there is no live Supabase project
# yet. auth-service starts and serves health checks without this set; it
# just can't Register/Login until it's configured.
DATABASE_URL=postgres://auth_service.CHANGE_ME_PROJECT_REF:CHANGE_ME_PASSWORD@CHANGE_ME_REGION.pooler.supabase.com:6543/postgres

# JWT `iss` claim. Distinct per service issuing tokens (only auth-service
# does, today).
JWT_ISSUER=skill-bridge-platform/auth-service

# Optional: PEM-encoded RSA private key (PKCS1 or PKCS8). If unset, a
# fresh RS256 keypair is generated at process startup — fine for local
# dev, NOT fine for anything that restarts or runs more than one replica
# (see backend/cmd/auth-service/README.md).
# JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Optional: override the derived kid when JWT_PRIVATE_KEY_PEM is set.
# JWT_KID=

# --- api-gateway --------------------------------------------------------------

# HTTP port (GraphQL + Playground + health).
# PORT=8080

# Where to reach auth-service's gRPC server.
AUTH_SERVICE_ADDR=localhost:9001

# Where to reach auth-service's JWKS document.
AUTH_SERVICE_JWKS_URL=http://localhost:8081/.well-known/jwks.json
