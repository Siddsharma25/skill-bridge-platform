# Multi-stage build for auth-service. Final stage is distroless/static, not
# alpine: alpine still carries a shell and a package manager, which is more
# attack surface and image weight than a statically-linked Go binary ever
# needs at runtime. distroless/static has no shell, no package manager, not
# even libc — just enough to run a static binary and resolve TLS certs.
FROM golang:1.27-alpine AS build
WORKDIR /src

# Cache module downloads separately from source changes.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
# CGO_ENABLED=0 is required for distroless/static (no libc present);
# -trimpath keeps build-machine paths out of the binary.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/auth-service ./cmd/auth-service

FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/auth-service /auth-service
USER nonroot:nonroot

# gRPC port and HTTP (health + JWKS) port — see backend/.env.example.
EXPOSE 9001 8081

ENTRYPOINT ["/auth-service"]
