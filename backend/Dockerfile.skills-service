# See Dockerfile.auth-service for why distroless/static over alpine.
FROM golang:1.27-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/skills-service ./cmd/skills-service

FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/skills-service /skills-service
USER nonroot:nonroot

# gRPC port and HTTP (health) port — see backend/.env.example.
EXPOSE 9002 8082

ENTRYPOINT ["/skills-service"]
