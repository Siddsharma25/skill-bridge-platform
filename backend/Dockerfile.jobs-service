# See Dockerfile.auth-service for why distroless/static over alpine.
FROM golang:1.27-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/jobs-service ./cmd/jobs-service

FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/jobs-service /jobs-service
USER nonroot:nonroot

# gRPC port and HTTP (health) port — see backend/.env.example.
EXPOSE 9004 8084

ENTRYPOINT ["/jobs-service"]
