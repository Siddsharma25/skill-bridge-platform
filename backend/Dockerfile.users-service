# See Dockerfile.auth-service for why distroless/static over alpine.
FROM golang:1.27-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/users-service ./cmd/users-service

FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/users-service /users-service
USER nonroot:nonroot

# gRPC port and HTTP (health) port — see backend/.env.example.
EXPOSE 9003 8083

ENTRYPOINT ["/users-service"]
