# Copy to frontend/.env.local for local dev (gitignored — see root
# .gitignore's `**/.env.*local`; Vite loads .env.local automatically, see
# https://vitejs.dev/guide/env-and-mode.html). Only .env.example is
# tracked.
#
# The frontend doesn't call the backend yet (see frontend/CLAUDE.md and
# docs/DECISIONS.md's Phase 7 notes — this is scaffolding for when it
# does, not a feature built this phase). VITE_API_URL is where a future
# TanStack Query client / GraphQL client would point; nothing in src/
# reads it yet.
#
# Local dev: api-gateway's default HTTP port (see backend/README.md's
# ports table).
VITE_API_URL=http://localhost:8080/query

# Production (Vercel): point this at the deployed Render service's
# /query endpoint once it exists — see render.yaml and the root README's
# "Deploying" section. CHANGE_ME is a placeholder; there is no real Render
# URL yet (creating the Render service is a step only the account owner
# can do — see the root README).
# VITE_API_URL=https://CHANGE_ME.onrender.com/query
